{
  "version": 4,
  "logging": { "level": "debug" },
  "tasksCheckbox": { "rule": "not a rule" },
  "journals": {
    "work": {
      "name": "work",
      "write": { "type": "day" },
      "folder": "work",
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "tasks": { "providers": { "checkbox": { "compose": "replace", "mode": "and", "conditions": [] } } }
    }
  }
}
