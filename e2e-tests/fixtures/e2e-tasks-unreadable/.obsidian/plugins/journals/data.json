{
  "version": 4,
  "logging": { "level": "debug" },
  "tasksNoteProperty": { "enabled": true, "setUp": true },
  "journals": {
    "daily": {
      "name": "daily",
      "write": { "type": "day" },
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "tasks": { "filter": { "mode": "and", "conditions": [{ "type": "priority", "above": 2 }] } }
    },
    "work": {
      "name": "work",
      "write": { "type": "day" },
      "folder": "work",
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "tasks": {
        "providers": {
          "note-property": {
            "show": "matching",
            "mode": "or",
            "conditions": [
              { "type": "priority", "above": 2 },
              { "type": "tag", "tags": [] }
            ]
          }
        },
        "filter": { "mode": "and", "conditions": "tag: #w" }
      }
    }
  }
}
