{
  "version": 4,
  "logging": { "level": "debug" },
  "journals": {
    "sprint": {
      "name": "sprint",
      "write": { "type": "custom", "every": "week", "duration": 2, "anchorDate": "2026-01-05" },
      "folder": "sprint",
      "nameTemplate": "{{date}}",
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": true,
        "addEndDate": true
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "timeline": { "start": "", "end": { "kind": "never" } }
    },
    "monthly": {
      "name": "monthly",
      "write": { "type": "custom", "every": "month", "duration": 1, "anchorDate": "2026-01-01" },
      "folder": "monthly",
      "nameTemplate": "{{date}}",
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": true,
        "addEndDate": true
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "timeline": { "start": "", "end": { "kind": "never" } }
    }
  },
  "shelves": {}
}
