{
  "version": 9,
  "logging": { "level": "debug" },
  "journals": {
    "daily": {
      "name": "daily",
      "write": { "type": "day" },
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "decorations": [
        {
          "mode": "and",
          "conditions": [{ "type": "date", "day": 12, "month": -1, "year": null }],
          "styles": [{ "type": "corner", "placement": "top-left", "color": { "type": "custom", "color": "#ff0000" } }]
        }
      ]
    }
  },
  "decorations": {
    "decorations": [
      {
        "name": "Release day",
        "mode": "and",
        "conditions": [{ "type": "date", "day": 12, "month": -1, "year": null }],
        "styles": [{ "type": "corner", "placement": "top-right", "color": { "type": "custom", "color": "#0000ff" } }]
      }
    ]
  }
}
