{
  "extends": "@tsconfig/node24/tsconfig.json",
  // src/settings/version.ts is listed for the same reason as the paraglide messages: the
  // migration specs assert the shipped constant rather than retyping it, and this is a
  // composite project, so an imported file outside `include` raises TS6307 on every file here.
  "include": ["wdio.conf.mts", "e2e/**/*.ts", "src/i18n/paraglide/**/*.js", "src/settings/version.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Assertions import the shipped copy from src/i18n/paraglide, which is generated JS
    // carrying its types in JSDoc — the same reason tsconfig.app.json allows JS.
    "allowJs": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "mocha", "@wdio/globals/types", "wdio-obsidian-service"]
  }
}
