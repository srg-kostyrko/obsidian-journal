{
  "name": "obsidian-journal",
  "version": "3.0.0",
  "description": "Journal plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/paraglide --output-structure locale-modules",
    "check:i18n": "node scripts/check-i18n-glossary.mjs",
    "version": "node version-bump.mjs && git add manifest.json manifest-beta.json versions.json CHANGELOG.md",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && wdio run ./wdio.conf.mts",
    "test:e2e:smoke": "npm run build && wdio run ./wdio.conf.mts --suite smoke",
    "test:e2e:integration": "npm run build && wdio run ./wdio.conf.mts --suite integration",
    "test:e2e:migration": "npm run build && wdio run ./wdio.conf.mts --suite migration",
    "test:e2e:interop": "npm run build && wdio run ./wdio.conf.mts --suite interop",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "check:types": "vue-tsc -b",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:srg-kostyrko/obsidian-journal.git"
  },
  "keywords": [
    "Obsidian",
    "plugin",
    "journal"
  ],
  "author": "Sergii Kostyrko",
  "license": "MIT",
  "dependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@vee-validate/valibot": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "nanoevents": "^10.0.0",
    "nanoid": "^6.0.1",
    "obsidian": "^1.13.1",
    "perfect-debounce": "^2.1.0",
    "sortablejs": "^1.15.7",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.4.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/user-event": "^14.6.4",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/tsconfig": "^0.9.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/junit-reporter": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wdio-obsidian-reporter": "^3.1.3",
    "wdio-obsidian-service": "^3.1.3"
  },
  "nano-staged": {
    "*.{ts,vue}": "eslint",
    "*.{ts,mjs,js,css,md,vue}": "prettier --write"
  }
}
