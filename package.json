{
  "name": "obsidian-journal",
  "version": "2.1.10",
  "description": "Journal plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/paraglide",
    "version": "node version-bump.mjs && git add manifest.json manifest-beta.json versions.json",
    "check:lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "check:types": "vue-tsc -b",
    "changelog": "npx git-cliff --output CHANGELOG.md",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:srg-kostyrko/obsidian-journal.git"
  },
  "keywords": [
    "Obsidian",
    "plugin",
    "journal"
  ],
  "author": "Sergii Kostyrko",
  "license": "MIT",
  "dependencies": {
    "@inlang/paraglide-js": "^2.18.0",
    "@vee-validate/valibot": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "eslint-plugin-vue": "^10.9.0",
    "nanoevents": "^9.1.0",
    "nanoid": "^5.1.11",
    "obsidian": "^1.12.3",
    "perfect-debounce": "^2.1.0",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.3.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/tsconfig": "^0.9.1",
    "builtin-modules": "^5.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "git-cliff": "^2.12.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint",
    "*.{ts,mjs,js,css,md,vue}": "prettier --write"
  }
}
