# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules
# packages/api is not a workspace, so `cd packages/api && npm publish` (docs/releasing.md)
# resolves its own peer tree and leaves a lockfile behind. node_modules is already covered
# above; without this line the lockfile beside it is one `git add -A` from being committed.
packages/api/package-lock.json


test-vault/.obsidian/plugins/journals/*
!test-vault/.obsidian/plugins/journals/.hotreload
build/

# generated by scripts/generate-perf-vault.mjs
perf-vault/

test-vault/.obsidian/plugins/*
test-vault/.obsidian/themes/*
test-vault/.obsidian/app.json
test-vault/.obsidian/appearance.json
test-vault/.obsidian/core-plugins-migration.json
test-vault/.obsidian/core-plugins.json
test-vault/.obsidian/workspace.json
test-vault/.obsidian/workspace-mobile.json
test-vault/**/*.md

# e2e (WebdriverIO + Obsidian)
.obsidian-cache/
e2e/.reports/

# Exclude sourcemaps
*.map

# obsidian
data.json
# e2e fixtures commit a curated plugin config as their starting state.
!e2e/fixtures/**/data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

.eslintcache

coverage

.superpowers/

# Retired 2026-08-13 — specs and plans now live in .superpowers/
docs/superpowers/
