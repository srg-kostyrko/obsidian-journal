{
  "version": 4,
  "journals": {
    "daily": {
      "name": "daily",
      "write": { "type": "day" },
      "folder": "Journals/{{date:YYYY}}/{{date:MM}}",
      "nameTemplate": "{{date:DD}}",
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] }
    },
    "quarterly": {
      "name": "quarterly",
      "write": { "type": "quarter" },
      "folder": "Quarters/{{date:YYYY}}",
      "nameTemplate": "{{date:[Q]Q}}",
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-[Q]Q",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] }
    }
  },
  "shelves": {}
}
