{
  "version": 4,
  "journals": {
    "daily": {
      "name": "daily",
      "write": { "type": "day" },
      "folder": "day",
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "nameTemplate": "{{date}}",
      "templates": [],
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "noteletField": "journal-notelet",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "notelets": {
        "meeting": {
          "id": "meeting",
          "name": "Meeting",
          "folder": "notelets",
          "nameTemplate": "{{date}} Meeting {{notelet_index}}",
          "templates": [],
          "counter": { "enabled": true, "frontmatterKey": "journal-notelet-index" },
          "prompts": []
        },
        "retro": {
          "id": "retro",
          "name": "Retro",
          "folder": "notelets",
          "nameTemplate": "{{date}} Retro",
          "templates": [],
          "counter": { "enabled": false, "frontmatterKey": "journal-notelet-index" },
          "prompts": []
        }
      },
      "decorations": [
        {
          "mode": "and",
          "conditions": [{ "type": "has-notelet", "typeIds": [] }],
          "styles": [{ "type": "corner", "placement": "top-left", "color": { "type": "custom", "color": "#ff0000" } }]
        },
        {
          "mode": "and",
          "conditions": [{ "type": "has-notelet", "typeIds": ["retro"] }],
          "styles": [{ "type": "background", "color": { "type": "custom", "color": "#203040" } }]
        }
      ]
    }
  }
}
