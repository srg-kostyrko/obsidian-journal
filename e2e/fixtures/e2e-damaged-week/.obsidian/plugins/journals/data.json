      "write": { "type": "week" },
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-[W]ww",
      "nameTemplate": "{{date:YYYY-[W]ww}}",
      "folder": "Weeks",
