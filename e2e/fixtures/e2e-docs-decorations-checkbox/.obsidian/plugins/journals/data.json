{
  "version": 4,
  "logging": { "level": "debug" },
  "journals": {
    "daily": {
      "name": "daily",
      "write": { "type": "day" },
      "timeline": { "start": "", "end": { "kind": "never" } },
      "dateFormat": "YYYY-MM-DD",
      "frontmatter": {
        "dateField": "journal-date",
        "startDateField": "journal-start-date",
        "endDateField": "journal-end-date",
        "addStartDate": false,
        "addEndDate": false
      },
      "numbering": { "enabled": false, "anchorDate": "", "allowBefore": false, "sources": [] },
      "decorations": [
        {
          "mode": "and",
          "conditions": [{ "type": "property", "name": "workout", "valueType": "checkbox", "condition": "is-true" }],
          "styles": [{ "type": "background", "color": { "type": "custom", "color": "#2e7d32" } }]
        },
        {
          "mode": "and",
          "conditions": [{ "type": "property", "name": "workout", "valueType": "checkbox", "condition": "is-false" }],
          "styles": [{ "type": "background", "color": { "type": "custom", "color": "#888888" } }]
        }
      ]
    }
  }
}
