{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // Matches the UTC crons in e2e.yml and stale.yml, so every scheduled job in
  // this repo is read against one clock.
  timezone: "Etc/UTC",
  schedule: ["before 06:00 on monday"],

  // Every pull request costs a full e2e job — build plus a real Obsidian
  // download plus five suites. Batching weekly and capping concurrency keeps
  // that bill bounded; the dependency dashboard carries whatever is held back.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // The repo has "Allow auto-merge" off and no branch protection on main, so
  // GitHub's native auto-merge is never offered. Renovate has to watch the
  // branch status and merge through the API itself.
  platformAutomerge: false,

  labels: ["dependencies"],

  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 06:00 on the first day of the month"],
  },

  // A vulnerability fix must not sit until Monday.
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },
  osvVulnerabilityAlerts: true,

  packageRules: [
    {
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      groupName: "devDependencies",
      semanticCommitType: "chore",
      semanticCommitScope: "deps-dev",
      automerge: true,
    },
    {
      matchManagers: ["npm"],
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dependencies",
      semanticCommitType: "chore",
      semanticCommitScope: "deps",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      semanticCommitType: "chore",
      semanticCommitScope: "ci",
      schedule: ["before 06:00 on the first day of the month"],
      // A tag is a mutable pointer: `@v7` resolves at run time to whatever the
      // tag points at *now*, so whoever can move it changes the code CI runs
      // with no diff in this repo to review. That is the shape the
      // tj-actions/changed-files compromise took. A digest is content-addressed,
      // so an upgrade becomes a reviewable bump on the schedule above instead.
      // It earns its keep in release.yml and release-beta.yml, which run at
      // `permissions: write-all` and build the artifact users install — an
      // attested build is only as trustworthy as the attesting action.
      pinDigests: true,
    },
    {
      // The typings and manifest.json's minAppVersion move independently, and
      // nothing in CI catches a newly-typed API that is missing on our floor.
      matchPackageNames: ["obsidian"],
      groupName: null,
      automerge: false,
      prBodyNotes: [
        "> [!WARNING]",
        "> This bumps the Obsidian **typings** only. `manifest.json`'s `minAppVersion` is a separate, deliberate decision — raising it drops users on older Obsidian builds, and `e2e.yml`'s `earliest/earliest` matrix leg pins the floor the suite actually runs against. Check any newly available API against that floor before merging.",
      ],
    },
    {
      // wdio-obsidian-service peers on webdriverio ^9 (3.3.0, its latest), so a
      // wdio 10 bump cannot produce a lockfile and fails `npm ci` everywhere
      // (#523). Lift this once a release of it accepts webdriverio 10.
      matchPackageNames: ["webdriverio", "@wdio/**"],
      allowedVersions: "<10",
    },
    {
      // These pin what obsidian-local-rest-api bundles, not what we run: the
      // shipped code imports zod as a type only, and zod3-shape.test.ts checks
      // our forged nodes against the host's own zod 3. Its latest (5.3.0) peers
      // on zod ^3.25.76, so a zod 4 bump cannot produce a lockfile (#554).
      // Off rather than capped: a vulnerability PR carries its own
      // allowedVersions and ignores ours. Move both by hand when the host does.
      matchPackageNames: ["zod", "zod-to-json-schema"],
      enabled: false,
    },
    {
      // .tool-versions says `nodejs latest`, which is not a version Renovate
      // can reason about. Off explicitly rather than by accident.
      matchManagers: ["asdf"],
      enabled: false,
    },
  ],
}
